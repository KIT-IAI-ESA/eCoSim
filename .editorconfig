# Doc: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space

[{*.py,*.pyw}]
max_line_length = 150

[*.ini]
# windows ini files need special handling
insert_final_newline = unset
end_of_line = unset
