    family-names: Çakmak
    orcid: "https://orcid.org/0000-0002-1463-7606"
license: Apache-2.0
repository-code: "https://github.com/KIT-IAI-ESA/eCoSim"
url: "https://ecosim.easimov.com/"
keywords:
  - co-simulation
  - FMI
  - energy systems
  - HPC
