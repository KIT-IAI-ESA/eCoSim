{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "0.0.0.0",
    "port": 29333
  },
  "permission": {
    "external_directory": {
      "/home/opencode/ecosim/**": "allow",
      "/home/opencode/.config/opencode/**": "allow"
    }
  },
  "agent": {
    "example-agent" : {
      "mode": "primary",
      "prompt": "{file:agent_prompts/example-agent.md}"
    }
  },
  "provider": {
    "kit": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KIT KI-Toolbox",
      "options": {
        "baseURL": "https://ki-toolbox.scc.kit.edu/api/v1"
      },
      "models": {
