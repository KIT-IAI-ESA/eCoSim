{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "0.0.0.0",
    "port": 29333
  },
  "permission": {
    "external_directory": {
      "/home/node/ecosim/**": "allow",
      "/home/node/.config/opencode/**": "allow"
    }
  },
  "agent": {
    "ecosim-programmer": {
      "mode": "primary",
      "prompt": "{file:agents/roles/ecosim-programmer.md}"
    }
  },
  "provider": {
    "kit": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KIT KI-Toolbox",
      "options": {
        "baseURL": "https://ki-toolbox.scc.kit.edu/api/v1"
      }
    }
  },
  "model": "kit/kit.minimax-m2.7-229b",
  "small_model": "kit/kit.mistral-small-4-119b-a8b"
}
